# هذا الملف للتوثيق فقط: التطبيق لا يقرأ ملف .env.
# القيم تُمرَّر وقت البناء:  flutter run --dart-define-from-file=config/dev.json
# انسخ config/dev.example.json إلى config/dev.json (مستثنى من Git) وضع القيم الحقيقية هناك.

SATR_PROJECT_KEY=pk_test_REPLACE_ME      # مطلوب: ترويسة X-Project-Key
SATR_BASE_URL=https://masar.toldpath.com  # اختياري
SATR_DEV_MEMBER=                          # اختياري: X-Dev-Member لبيئة التجربة
SATR_LOCALE=ar                            # اختياري: ar | en
GEMINI_API_KEY=                           # اختياري: صوت المساعد وفهم الجمل (مفتاح داخل العميل: للتطوير فقط)
SATR_PICKUP_LAT=                          # نقطة استلام التسعيرة (الافتراضي في الكود إحداثيات غزة!)
SATR_PICKUP_LNG=
SATR_PICKUP_LABEL=
SATR_PICKUP_DETAILS=
SATR_DEFAULT_COUNTRY_CODE=                # اختياري: مثل 970 لتحويل 05… إلى +970 5…
SATR_APP_VERSION=1.0.0                    # اختياري: X-App-Version
SATR_APP_ID=com.example.project           # اختياري: رابط تحديث المتجر
